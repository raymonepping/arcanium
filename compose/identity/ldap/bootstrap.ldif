# Prompt 27 — scoped-role demo accounts (Control-Plane Multi-Tenancy).
# Neither account holds a BARE arcanium-operator/arcanium-auditor group —
# only the scoped variant — so scenarios/16_multitenancy/test_scope_isolation.sh
# can prove the scoped-grant path actually restricts access, not merely that
# it's additive on top of an already-unrestricted estate-wide role.
dn: uid=demo-operator-prod,ou=people,dc=arcanium,dc=local
objectClass: inetOrgPerson
uid: demo-operator-prod
cn: Demo Operator Production
sn: Production
givenName: Demo
mail: demo-operator-prod@arcanium.local
userPassword: Arcanium-opprod-2026

dn: uid=demo-auditor-platform,ou=people,dc=arcanium,dc=local
objectClass: inetOrgPerson
uid: demo-auditor-platform
cn: Demo Auditor Platform
sn: Platform
givenName: Demo
mail: demo-auditor-platform@arcanium.local
userPassword: Arcanium-auditplat-2026

# ── Groups ───────────────────────────────────────────────────────────────

dn: cn=arcanium-ciso,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-ciso
member: uid=demo-ciso,ou=people,dc=arcanium,dc=local

dn: cn=arcanium-architect,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-architect
member: uid=demo-architect,ou=people,dc=arcanium,dc=local

dn: cn=arcanium-operator,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-operator
member: uid=demo-operator,ou=people,dc=arcanium,dc=local

dn: cn=arcanium-auditor,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-auditor
member: uid=demo-auditor,ou=people,dc=arcanium,dc=local

# Role group — separate axis from the tenant-scope groups below.
dn: cn=arcanium-supplier-admin,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-supplier-admin
member: uid=demo-pepsi,ou=people,dc=arcanium,dc=local
member: uid=demo-cocacola,ou=people,dc=arcanium,dc=local

# Tenant-scope groups — which tenant, independent of role.
dn: cn=arcanium-tenant-pepsi,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-tenant-pepsi
member: uid=demo-pepsi,ou=people,dc=arcanium,dc=local

dn: cn=arcanium-tenant-cocacola,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-tenant-cocacola
member: uid=demo-cocacola,ou=people,dc=arcanium,dc=local

# Prompt 27 — scoped-role groups (env/team dimensions). Each of these two
# demo accounts is a member of ONLY the scoped variant below, never the
# bare "arcanium-operator"/"arcanium-auditor" groups above — that's what
# makes them useful for proving the scoped path actually restricts, not
# just that it's additive.
dn: cn=arcanium-operator:env:production,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-operator:env:production
member: uid=demo-operator-prod,ou=people,dc=arcanium,dc=local

dn: cn=arcanium-auditor:team:platform,ou=groups,dc=arcanium,dc=local
objectClass: groupOfNames
cn: arcanium-auditor:team:platform
member: uid=demo-auditor-platform,ou=people,dc=arcanium,dc=local
