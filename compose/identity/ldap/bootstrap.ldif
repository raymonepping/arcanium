# Prompt 18 — Arcanium demo identity fixture.
#
# Fresh, Arcanium-specific — NOT copied from workshop/zero_trust's
# bootstrap.ldif (which carries real personal names). Every person entry
# below is a fictional demo persona, and every password is POC-only,
# matching the disclosure convention scripts/vault-seed-users.sh already
# uses for the (now-retired) Vault userpass demo accounts.
#
# Structure: ou=people + ou=groups under dc=arcanium,dc=local. Groups use
# groupOfNames (Keycloak's LDAP group mapper reads the `member` attribute).
# arcanium-supplier-admin is a role group, separate from the per-tenant
# arcanium-tenant-* scope groups (input/36 — role and tenant scope are two
# independent axes, not inferred from each other).

dn: ou=people,dc=arcanium,dc=local
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=arcanium,dc=local
objectClass: organizationalUnit
ou: groups

# ── People ───────────────────────────────────────────────────────────────

dn: uid=demo-ciso,ou=people,dc=arcanium,dc=local
objectClass: inetOrgPerson
uid: demo-ciso
cn: Demo Ciso
sn: Ciso
givenName: Demo
mail: demo-ciso@arcanium.local
userPassword: Arcanium-ciso-2026

