# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# Vault Enterprise license token (raw base32 string, no header line)
VAULT_LICENSE=02MV4UU43BK5HGY...

# Vault Enterprise license with HSM feature (used by vault-hsm only)
VAULT_LICENSE_ENT=02MV4UU43BK5HGY...

# PostgreSQL — Vault management credentials ONLY.
# Used once by Terraform (terraform/vault-database/) to register the DB
# connection with Vault's Database secrets engine.
# The Arcanium API never reads these — it gets dynamic credentials from Vault.
POSTGRES_USER=arcanium
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=arcanium_db

# SoftHSM2 PKCS#11 token — used by vault-hsm for PKCS#11 auto-unseal.
# These are set once at token init; changing them requires re-initialising the token.
SOFTHSM_TOKEN_LABEL=arcanium-hsm
SOFTHSM_SO_PIN=<security-officer-pin>
SOFTHSM_USER_PIN=<user-pin>

# Arcanium API — AppRole credentials
# ARCANIUM_VAULT_ROLE_ID: from `terraform output approle_arcanium_api_role_id`
#   or: vault read auth/approle/role/arcanium-api/role-id
# ARCANIUM_VAULT_SECRET_ID: generated once after tf-platform is applied:
#   vault write -f auth/approle/role/arcanium-api/secret-id
ARCANIUM_VAULT_ROLE_ID=<role-id-from-terraform-output>
ARCANIUM_VAULT_SECRET_ID=<secret-id-generated-after-apply>

# Document-signing workload — AppRole credentials
# DOCSIGN_VAULT_ROLE_ID: from `terraform output document_signing_workload_role_id`
#   or: vault read auth/approle/role/document-signing-workload/role-id
# DOCSIGN_VAULT_SECRET_ID: vault write -f auth/approle/role/document-signing-workload/secret-id
DOCSIGN_VAULT_ROLE_ID=<role-id-from-terraform-output>
DOCSIGN_VAULT_SECRET_ID=<secret-id-generated-after-apply>

# External-supplier workload — AppRole credentials + Arcanium app_id
# Generated by: make approval-provision
# SUPPLIER_VAULT_ROLE_ID: from `vault read auth/approle/role/external-supplier/role-id`
# SUPPLIER_ARCANIUM_APP_ID: UUID assigned by Arcanium API on registration
SUPPLIER_VAULT_ROLE_ID=<role-id-from-vault>
SUPPLIER_VAULT_SECRET_ID=<secret-id-generated-by-provision>
SUPPLIER_ARCANIUM_APP_ID=<uuid-from-arcanium-api>
APPROVER_VAULT_ROLE_ID=<role-id-from-vault>
APPROVER_VAULT_SECRET_ID=<secret-id-generated-by-provision>

# Supplier isolation — Vault namespace credentials
# These are written automatically by scenarios/06_supplier_isolation/provision.sh
# into .env.workloads — see that script for details.
# PEPSI_VAULT_ROLE_ID=<pepsi-approle-role-id>
# PEPSI_VAULT_SECRET_ID=<pepsi-approle-secret-id>
# COCACOLA_VAULT_ROLE_ID=<cocacola-approle-role-id>
# COCACOLA_VAULT_SECRET_ID=<cocacola-approle-secret-id>

# ==============================================================================
# Managed Key custody (Prompt 14.1) — read-only Arcanium API client for vault-hsm.
# Written by `make hsm-managed-keys` (scripts/vault-hsm-bootstrap.sh).
# ==============================================================================
VAULT_HSM_ADDR=https://vault-hsm:8200
# ARCANIUM_HSM_ROLE_ID=<arcanium-hsm-read role_id>
# ARCANIUM_HSM_SECRET_ID=<arcanium-hsm-read secret_id>
