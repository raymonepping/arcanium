+    fi
+  else
+    echo '{"status":"UNKNOWN","detail":"keycloak not running"}' > "$d/keycloak-discovery.json"
+  fi
+
+  if $ldap_auth_ok && $kc_discovery_ok; then set_status identity CAPTURED
+  elif $ldap_up || $kc_up; then set_status identity PARTIAL
+  else set_status identity UNKNOWN
+  fi
