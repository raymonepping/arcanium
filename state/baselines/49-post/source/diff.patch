       VAULT_SECRET_ID: "${SUPPLIER_VAULT_SECRET_ID}"
       ARCANIUM_API: "http://arcanium-api:3001"
       ARCANIUM_APP_ID: "${SUPPLIER_ARCANIUM_APP_ID}"
+      # Prompt 49 — POST /api/v1/approvals requires an authenticated
+      # caller once ARCANIUM_AUTH_ENABLED=true (this deployment always
+      # runs that way); a Prompt 28 service-account token, minted by
