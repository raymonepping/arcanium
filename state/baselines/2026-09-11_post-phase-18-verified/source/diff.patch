diff --git a/.env.example b/.env.example
index 11e1ad4..4eb657a 100644
--- a/.env.example
+++ b/.env.example
@@ -61,3 +61,30 @@ APPROVER_VAULT_SECRET_ID=<secret-id-generated-by-provision>
 VAULT_HSM_ADDR=https://vault-hsm:8200
 # ARCANIUM_HSM_ROLE_ID=<arcanium-hsm-read role_id>
 # ARCANIUM_HSM_SECRET_ID=<arcanium-hsm-read secret_id>
+
+# ==============================================================================
+# Identity stack (Prompt 18) — OpenLDAP (identity store) + Keycloak (OIDC
+# broker). Arcanium's Express API is the confidential OIDC client; the
+# browser never sees an OIDC token, a Vault token, or an LDAP credential.
+# ==============================================================================
+LDAP_ADMIN_PASSWORD=change-me-before-use
+KEYCLOAK_ADMIN=arcanium-admin
+KEYCLOAK_ADMIN_PASSWORD=change-me-before-use
+# Keycloak's browser-facing hostname:port (the published port from
+# compose/identity/compose.yaml) — stamped into `iss` and every browser-facing URL.
+KC_HOSTNAME=http://localhost:8083
+
+# The browser-visible origin the Nuxt gateway serves from.
+ARCANIUM_BASE_URL=http://localhost:3000
+# Must equal http://<KC_HOSTNAME>/realms/arcanium — used for issuer validation.
+ARCANIUM_OIDC_ISSUER=http://localhost:8083/realms/arcanium
+# Container-network address — Express uses this for every server-to-server
+# call (token exchange, JWKS, userinfo, end-session). Never used by the browser.
+ARCANIUM_OIDC_INTERNAL_URL=http://keycloak:8080
+# Only used to build the browser-facing authorization-endpoint redirect.
+ARCANIUM_OIDC_PUBLIC_URL=http://localhost:8083
+ARCANIUM_OIDC_CLIENT_ID=arcanium-api
+# Must exactly match the redirect URI registered on the Keycloak client.
+ARCANIUM_API_CALLBACK_URL=http://localhost:3000/gateway/api/v1/auth/callback
+# Printed once by compose/identity/keycloak/setup_keycloak.sh — paste it here.
+ARCANIUM_OIDC_CLIENT_SECRET=<client-secret-from-setup_keycloak.sh-output>
